# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# macOS AppleDouble metadata files (created on non-APFS volumes like the T7)
._*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ESCO source data — bundled Tomcat/Fuseki API package (7.7 GB). Not used at
# runtime (data lives in Supabase); never commit it.
tomcat-esp-api-v03_94/

# The original Claude Code prompt brief (keep local, not part of the app)
esco-app-claude-code-prompt-v2.md
