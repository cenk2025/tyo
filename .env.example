# --- Supabase ---
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public anon key (safe to expose; RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER ONLY. Bypasses RLS. Used for guest-profile migration
# and account deletion. Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public base URL, used for auth redirect callbacks. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI (Anthropic) — SERVER ONLY, OPTIONAL ---
# NOT used by the default AI-assist path, which runs on NVIDIA (see below).
# Only src/lib/ai/resolve-skills.ts reads this — a higher-precision, paid
# alternative resolver that nothing currently calls. Leave unset unless you
# wire that resolver back in. Never prefix NEXT_PUBLIC_.
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-opus-4-8

# --- Feature flags ---
# Show the AI-assisted free-text skill mapping screen. (Uses NVIDIA_API_KEY
# below when present; otherwise the trigram fallback.)
NEXT_PUBLIC_FEATURE_AI_ASSIST=true

# --- AI-assist (NVIDIA NIM, free tier) — SERVER ONLY ---
# One key powers both halves of AI-assist:
#   chat model       free text -> canonical skill phrases (extract-skills.ts)
#   embedding model  phrases -> ESCO rows by meaning      (resolve-hybrid.ts)
# Without it, resolution falls back to trigram/ILIKE search — no error, much
# lower recall in Finnish.
# Free key at https://build.nvidia.com → any model page → "Get API Key".
NVIDIA_API_KEY=nvapi-your-key
# Optional overrides. NOTE: changing NVIDIA_EMBED_MODEL invalidates every stored
# vector — re-run scripts/backfill-skill-embeddings.mjs for the whole table.
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_CHAT_MODEL=moonshotai/kimi-k3
# NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
